generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  logo        String?
  primaryColor String? @default("#6C63FF")
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("Active") // Active, Paused, Completed
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  platforms   Platform[]
  contents    Content[]
}

model Platform {
  id          String   @id @default(cuid())
  name        String   // Instagram, YouTube, etc.
  icon        String?
  brandColor  String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id              String   @id @default(cuid())
  title           String
  description     String?
  caption         String?
  platform        String   // Can link to Platform model in the future
  contentType     String   // Reel, Carousel, Post, etc.
  postingDate     DateTime?
  postingTime     String?
  status          String   @default("Idea") // Idea, Planned, Script Ready, etc.
  priority        String   @default("Medium") // High, Medium, Low
  thumbnail       String?
  referenceLink   String?
  driveLink       String?
  clientFeedback  String?
  revisionCount   Int      @default(0)
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
